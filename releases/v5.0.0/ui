<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"><meta name="theme-color" content="#081019"><title>Zabour | دمج الإنترنت</title>
<style>
:root{color-scheme:dark;--bg:#090e1b;--card:#141e2d;--line:#344053;--text:#f5f8fd;--muted:#9caac0;--mint:#2ce0ad;--purple:#9e7cff;--danger:#ff7785}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 0 30%,#07393688,transparent 42%),radial-gradient(ellipse at 100% 75%,#35275988,transparent 55%),#080d19;color:var(--text);font-family:Tahoma,Arial,sans-serif;font-size:14px;min-height:100vh}header{padding:20px 18px 8px;display:flex;align-items:center;justify-content:space-between;max-width:920px;margin:auto}.logo{font-weight:900;font-size:20px;letter-spacing:1.2px}.logo b{color:var(--mint)}.tag{color:#aab6ce;font-size:11px}.signal{display:flex;align-items:center;gap:7px;color:#afbac9;font-size:12px}.dot{width:8px;height:8px;border-radius:50%;background:#8290a6;box-shadow:0 0 12px #46556a}.dot.up{background:var(--mint);box-shadow:0 0 15px #2ce0ad}.wrap{max-width:920px;margin:auto;padding:10px 15px 112px}h1{font-size:23px;margin:10px 0 6px}h2{font-size:17px;margin:0 0 9px}.hint{color:var(--muted);font-size:12px;line-height:1.8;margin:0 0 12px}.panel{background:linear-gradient(140deg,#192734ed,#151728f5);border:1px solid #405067a8;border-radius:23px;padding:18px;margin:13px 0;box-shadow:inset 0 1px 0 #ffffff11,0 8px 30px #03061136}.panel.tint{background:linear-gradient(145deg,#143b38e0,#18172c)}.section-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}.pill{padding:7px 12px;background:#17293b;border:1px solid #3b4c61;border-radius:50px;color:#bccbde;font-size:12px}.chip{display:inline-flex;gap:8px;align-items:center;background:#152d30;border:1px solid #31665d;border-radius:24px;padding:7px 11px;color:#7ff0cb;font-size:12px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.stat{border:1px solid #3b4c62;background:#0e1b2dbb;border-radius:17px;padding:15px 11px;text-align:center}.num{font-size:23px;font-weight:800;direction:ltr}.num small{font-size:11px;font-weight:400;color:#aab8c8}.stat label{display:block;margin-top:6px;color:#aab8c7;font-size:12px}.gauge{width:205px;height:205px;margin:5px auto 10px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--mint) 0 8%,#26344c 8% 85%,#9f80ff 85% 87%,#26344c 87% 100%);box-shadow:0 0 42px #0eae8e22}.gauge-inner{height:162px;width:162px;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:50%;background:#101727;box-shadow:inset 0 3px 30px #0009}.gauge-inner strong{font-size:41px;direction:ltr}.gauge-inner span{color:#bdd1dd;font-size:12px}.linecard{display:flex;justify-content:space-between;align-items:center;border:1px solid #324b5c;padding:15px;border-radius:16px;margin:8px 0;background:#101a2a}.linecard .on{color:var(--mint)}.linecard .off{color:#abb0c3}.linecard strong{font-size:15px}.linecard small{font-size:11px;color:#9eafc1;display:block;margin-top:6px;direction:ltr;text-align:right}.linecard .speed{font-size:19px;font-weight:800;direction:ltr}input,select,textarea{width:100%;min-height:43px;border:1px solid #47536a;background:#202a3c;border-radius:13px;color:white;padding:11px 12px;outline:none;font-size:14px;font-family:inherit}input:focus,select:focus,textarea:focus{border-color:var(--mint)}textarea{resize:vertical;min-height:100px;direction:ltr;text-align:left}label.f{display:block;margin:11px 0 5px;color:#d1d9e7;font-size:12px}.field-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.btn{background:var(--mint);border:0;color:#041b1b;padding:12px 17px;border-radius:14px;cursor:pointer;font-weight:800;font-size:13px}.btn.secondary{background:#26334a;color:#dde8fb;border:1px solid #3e5069}.btn.danger{background:#4c2839;color:#ffacb7}.btn:disabled{opacity:.45;cursor:not-allowed}.buttons{display:flex;flex-wrap:wrap;gap:9px;margin-top:15px}.note{padding:12px;border:1px solid #52617e;border-radius:13px;background:#131e32;color:#d5d9e6;font-size:12px;line-height:1.9;margin-top:12px}.tab{display:none;animation:fade .2s ease}.tab.active{display:block}@keyframes fade{from{opacity:.3;transform:translateY(4px)}to{opacity:1;transform:none}}.modebox{display:flex;gap:9px}.mode{border-radius:15px;flex:1;min-width:0;padding:15px 7px;text-align:center;background:#122035;border:1px solid #34465b;cursor:pointer;color:#e5eefa}.mode b{display:block;font-size:13px}.mode span{display:block;color:#91a0b5;font-size:11px;margin-top:8px}.mode.chosen{border-color:var(--mint);background:#11453b}.switchrow{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 0;border-top:1px solid #2c3c51}.switch{appearance:none;width:54px;height:30px;min-height:30px;padding:0;margin:0;border:0;border-radius:22px;background:#47556b;position:relative;cursor:pointer;flex-shrink:0}.switch:before{content:"";display:block;width:24px;height:24px;background:#b1c0d1;border-radius:100%;position:absolute;top:3px;left:3px;transition:.2s}.switch:checked{background:var(--mint)}.switch:checked:before{background:#08271e;transform:translateX(24px)}nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,920px);background:#091525f5;backdrop-filter:blur(18px);border:1px solid #34465c;border-bottom:0;border-radius:22px 22px 0 0;display:flex;justify-content:space-around;padding:9px 4px max(11px,env(safe-area-inset-bottom));z-index:11}nav button{font-family:inherit;color:#93a4b8;flex:1;border:0;cursor:pointer;border-radius:12px;background:transparent;padding:7px 1px;font-size:10px;min-width:0}nav button span{display:block;font-size:21px;margin-bottom:5px}nav button.active{color:var(--mint);background:#123f38a6;outline:1px solid #1a6a61}#login{display:none!important}.login{position:fixed;inset:0;background:#060c15f5;display:grid;place-items:center;z-index:50;padding:18px}.login .panel{max-width:450px;width:100%}.hidden{display:none!important}.toast{position:fixed;bottom:86px;right:14px;left:14px;max-width:500px;margin:auto;background:#183b33;border:1px solid #3ba78d;border-radius:14px;padding:14px;z-index:30;line-height:1.7}.toast.error{background:#3e222a;border-color:#f08089}.item{border:1px solid #34465a;border-radius:14px;padding:12px;margin:9px 0;display:flex;gap:12px;align-items:center;justify-content:space-between}.item strong{display:block}.item small{display:block;color:#9daac0;font-size:11px;margin-top:7px}.code{background:#0b1421;color:#9debda;border-radius:12px;padding:12px;white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.6 monospace;direction:ltr;text-align:left}.steps{display:flex;flex-direction:column;gap:12px}.step{display:flex;align-items:center;gap:12px;font-size:12px;line-height:1.8}.step i{background:#104a40;border-radius:50%;display:grid;place-items:center;color:var(--mint);width:26px;height:26px;font-style:normal;flex-shrink:0}.small{font-size:11px;color:#aebad0}.kbd{font-family:monospace;direction:ltr;display:inline-block;color:#8ae6db}.divider{height:1px;background:#344155;margin:15px 0}@media(max-width:360px){.mode{padding:12px 4px}.num{font-size:20px}nav button{font-size:9px}nav button span{font-size:19px}}@media(min-width:760px){.desktop-cols{display:grid;grid-template-columns:1fr 1fr;gap:15px}.desktop-cols>.panel{align-self:start}}

.xlite-header{border:1px solid #33565b;border-radius:18px;background:linear-gradient(120deg,#052e2f99,#172342);padding:16px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.xlite-header strong{font-size:19px}.xlite-header small{display:block;font-weight:400;font-size:11px;color:#9ba8b7}.xlite-dot{color:#2ce0ad;font-size:12px}.port-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:12px 0}.port{padding:13px 5px;text-align:center;background:#101f2d;border:1px solid #37505a;border-radius:13px;color:#30dfb1;font-size:24px}.port small{display:block;font-size:12px;color:#afc2cf}.server-entry{margin:7px 0;display:flex;gap:8px;align-items:center;justify-content:space-between;background:#101d2b;border:1px solid #344759;border-radius:14px;padding:11px}.server-entry div{min-width:0}.server-entry strong{display:block;word-break:break-word}.server-entry small{font-size:11px;color:#9babbb;word-break:break-all}.server-entry button{font-size:12px;padding:8px 11px}.server-list{max-height:290px;overflow:auto}.btn:disabled{opacity:.5;cursor:not-allowed}
</style></head><body>
<header><div><div class="logo">ZABOUR <b>⟠</b></div><div class="tag">ROUTER · نظام دمج الإنترنت</div></div><div class="signal"><span class="dot" id="routerDot"></span><span id="routerTxt">جارِ الفحص</span></div></header>
<main class="wrap">
<section id="home" class="tab active"><div class="xlite-header"><strong>❖ ZABOUR <small>v5.0 · لوحة دمج الإنترنت</small></strong><span class="xlite-dot">● محلي</span></div><h1>الرئيسية</h1><p class="hint">الحالة الحقيقية للراوتر · السرعة الحالية · السيرفر · استهلاك الأجهزة</p><article class="panel tint"><div class="section-head"><h2>إجمالي سرعة التنزيل</h2><span class="pill">Mbps</span></div><div class="gauge"><div class="gauge-inner"><strong id="totalSpeed">0.0</strong><span>ميگابت / ثانية</span></div></div><div class="grid"><div class="stat"><div class="num" id="upCount">0/2</div><label>الخطوط المتصلة</label></div><div class="stat"><div class="num" id="sumRx">0.00 <small>GB</small></div><label>استقبال منذ تشغيل الواجهات</label></div></div></article><article class="panel"><div class="section-head"><h2>الخطوط</h2><span class="chip" id="activeMode">متوازن</span></div><div id="homeLines"></div><p class="hint">السرعة محسوبة من حركة واجهات الشبكة، وليست اختبار تنزيل اصطناعي.</p></article><article class="panel"><div class="section-head"><h2>📡 السيرفر الحالي</h2><button class="btn secondary" data-tab="servers">إدارة السيرفرات</button></div><div id="homeServer" class="hint">لا يوجد سيرفر محفوظ</div></article>
<article class="panel"><div class="section-head"><h2>🖧 الأجهزة والاستهلاك</h2><button class="btn secondary" data-tab="devices">عرض الأجهزة</button></div><div id="homeDeviceSummary" class="hint">قراءة حجوزات DHCP</div></article>
<article class="panel"><h2>خدمة VLESS</h2><div class="section-head"><span id="xrayStatus" class="pill">متوقف</span><button class="btn secondary" data-tab="servers">فتح السيرفرات</button></div></article></section>
<section id="merge" class="tab"><h1>الدمج ⚡</h1><p class="hint">ربط زين + آسياسيل أو زين + زين، عبر LAN أو Wi-Fi أو USB. يعمل أيضاً بخط واحد.</p><article class="panel tint"><div class="section-head"><h2>دمج الخطوط</h2><span class="chip">mwan3 · IPv4</span></div><div class="switchrow"><div><strong>توزيع الاتصالات على الخطين</strong><p class="hint">يجمع حركة التحميل متعددة الاتصالات</p></div><input type="checkbox" class="switch" id="mergeOn"></div><div class="note">الدمج هنا توزيع اتصالات (Load Balancing). سرعة الاتصال المفرد لا تصير 300 ميگابت تلقائياً بدون خادم يدعم تجميع القنوات.</div></article><article class="panel"><h2>منافذ الراوتر</h2><div class="port-grid"><div class="port">▢<small>LAN1</small></div><div class="port">▢<small>LAN2</small></div><div class="port">▢<small>LAN3</small></div><div class="port">▢<small>LAN4</small></div></div><p class="hint">المنافذ توضيحية؛ اختيار منفذ فعلي يحدده اكتشاف الشبكة. لا تحوّل منفذ الإدارة إلى WAN.</p><h2>شلون تضيف خط</h2><div class="steps"><div class="step"><i>1</i>اربط الراوتر الثاني بمنفذ LAN فارغ، أو شبّك الهاتف USB / نقطة اتصال Wi‑Fi.</div><div class="step"><i>2</i>اختار المنفذ أو طريقة الاتصال، وطبّق الإعداد.</div><div class="step"><i>3</i>اختار الخطين وفعّل الدمج؛ تصير الاتصالات موزعة بينهما.</div></div><div class="divider"></div><label class="f">واجهة الخط الأول (OpenWrt)</label><select id="wan1"><option value="wan">wan</option></select><label class="f">واجهة الخط الثاني (OpenWrt)</label><select id="wan2"><option value="zbwan2">zbwan2</option></select><h2 style="margin-top:22px">طريقة الدمج</h2><div class="modebox" id="modes"><button class="mode chosen" data-mode="balanced"><b>↻ بالتساوي</b><span>توزيع بحسب الأوزان</span></button><button class="mode" data-mode="latency"><b>⚡ أقل تأخير</b><span>الخط الأقل Ping</span></button><button class="mode" data-mode="failover"><b>⬡ احتياطي</b><span>الثاني عند الانقطاع</span></button></div><div class="field-row"><div><label class="f">وزن الأول</label><input type="number" id="weight1" value="2" min="1" max="20"></div><div><label class="f">وزن الثاني</label><input type="number" id="weight2" value="1" min="1" max="20"></div></div><label class="f">طريقة فحص عمل الخطوط</label><select id="trackMode"><option value="gateway">بوابة الراوتر · مناسب لباقات السوشيال</option><option value="public">فحص إنترنت عام · Ping 1.1.1.1</option></select><p class="hint">الأفضل للسوشيال هو فحص بوابة الراوتر. هذا يؤكد اتصال الراوتر بالمودم ولا يضمن وصول VLESS للسيرفر.</p><div class="buttons"><button class="btn" id="saveApply">تطبيق خيارات الدمج</button><button class="btn secondary" id="refreshBtn">تحديث الحالة</button></div></article><article class="panel"><h2>إضافة خط من منفذ LAN</h2><p class="hint">المنفذ راح ينفصل عن شبكة LAN الداخلية ويصير WAN؛ لا تختار المنفذ اللي داخل منه على الراوتر.</p><label class="f">منفذ مخصص للخط الثاني</label><select id="lanPort"><option value="">اختار المنفذ</option></select><button class="btn secondary" id="lanBtn" style="margin-top:12px">تحويل المنفذ إلى خط إنترنت</button></article><article class="panel"><h2>ربط الهاتف عبر USB</h2><p class="hint">فعّل مشاركة الإنترنت عبر USB من الهاتف قبل الربط.</p><label class="f">واجهة الهاتف المكتشفة (مثل usb0 أو eth1)</label><select id="usbDevice"><option value="">اختار الجهاز</option></select><button class="btn secondary" id="usbBtn" style="margin-top:12px">اعتماد خط USB</button></article><article class="panel"><h2>بث الهاتف عبر Wi‑Fi</h2><p class="hint">يجب أن يدعم الراوتر اتصال Wi‑Fi كعميل. أحياناً يتأثر بث شبكته بنفس الراديو.</p><label class="f">راديو الراوتر</label><select id="wifiRadio"></select><div class="note">تأكد أن الراديو مو مستخدم حالياً لتوصيل هاتفك بالراوتر. تغيير وضع Wi-Fi ممكن يقطع الإدارة.</div><div class="buttons"><button class="btn secondary" id="scanWifi">بحث عن الشبكات</button></div><pre id="wifiScanResult" class="code" style="white-space:pre-wrap;max-height:160px;overflow:auto">نتائج البحث تظهر هنا</pre><label class="f">اسم شبكة الهاتف</label><input id="hotspotSSID" autocomplete="off" placeholder="Hotspot SSID"><label class="f">رمز شبكة الهاتف</label><input id="hotspotPass" type="password" autocomplete="new-password" placeholder="8 أحرف أو أكثر"><button class="btn secondary" id="wifiBtn" style="margin-top:12px">الاتصال ببث الهاتف</button></article></section>
<section id="servers" class="tab"><h1>السيرفرات 🌐</h1><p class="hint">VLESS جاهز من اشتراكك الحالي، بدون شراء VPS جديد.</p><article class="panel tint"><div class="section-head"><h2>السيرفر الحالي</h2><span class="pill" id="serverLabel">لا يوجد سيرفر</span></div><div id="serverDetails" class="hint">أضف رابط VLESS أدناه.</div><div class="switchrow"><div><b>تفعيل Xray VLESS</b><p class="hint">SOCKS5 محلي على 127.0.0.1:10808</p></div><input type="checkbox" class="switch" id="vpnSwitch"></div><div class="switchrow"><div><b>تمرير TCP لأجهزة LAN تلقائياً</b><p class="hint">HTTP/HTTPS وTCP فقط، بدون UDP</p></div><input type="checkbox" class="switch" id="transparentSwitch"></div><div class="buttons"><button class="btn" id="startProxy">حفظ وتشغيل VLESS</button><button class="btn danger" id="stopProxy">إيقاف VLESS</button></div><p class="hint">لا تفعّل التوجيه الشامل قبل التأكد من أن السيرفر يعمل. بيانات VLESS محفوظة محلياً بالراوتر.</p></article><article class="panel"><div class="section-head"><h2>إدارة السيرفرات</h2><button class="btn secondary" id="serversRefresh">تحديث</button></div><div id="savedServers" class="server-list"><p class="hint">جارِ قراءة السيرفرات</p></div><p class="hint">تستطيع حفظ عدة سيرفرات، اختيار واحد وتشغيله. يتم عرض الاسم والعنوان فقط، دون إظهار UUID.</p></article>
<article class="panel"><h2>إضافة VLESS</h2><label class="f">الصق رابط VLESS</label><textarea id="vlessLink" placeholder="vless://UUID@server:port?type=tcp&security=none#Zabour" spellcheck="false"></textarea><div class="buttons"><button class="btn" id="saveVless">فحص الرابط وحفظه</button><button class="btn secondary" id="previewVless">عرض التفاصيل قبل الحفظ</button></div><div id="vlessPreview" class="note">الصق الرابط ثم افحصه. مدعوم TCP HTTP header وWS وgRPC وTLS وREALITY.</div><div class="note">مدعوم: TCP وHTTP header وWebSocket وgRPC، مع none/TLS/REALITY. لا يتم فك الملفات المقفلة أو إنشاء سيرفرات وهمية.</div></article></section>
<section id="routes" class="tab"><h1>التوزيع ↳</h1><p class="hint">التحكم بطريقة توزيع الاتصالات على خط زين أو آسياسيل أو خطين من نفس الشركة.</p><article class="panel"><h2>سياسة التوزيع</h2><div id="routeDetail" class="note">جارِ قراءة الحالة</div><div class="buttons"><button class="btn secondary" data-tab="merge">ضبط الأوزان</button></div></article><article class="panel"><h2>توزيع الاتصالات</h2><p class="hint">إذا كانت سرعة الأول 200 والثاني 100، جرّب وزن 2 للأول و1 للثاني. هذا يوزع عدد اتصالات أكثر للأول، مو ضمان أن السرعة تصير 300.</p><div class="three"><div class="stat"><div class="num" id="r1Weight">2</div><label>وزن الأول</label></div><div class="stat"><div class="num" id="r2Weight">1</div><label>وزن الثاني</label></div><div class="stat"><div class="num" id="rStatus">0/2</div><label>نشط</label></div></div></article></section>
<section id="isolation" class="tab"><h1>العزل ⛨</h1><p class="hint">إعدادات توجيه VLESS من دون تعطيل الشبكة المحلية.</p><article class="panel"><h2>حماية الأجهزة المحلية</h2><div class="note">النسخة الحالية تستثني شبكات LAN والعناوين الخاصة من اعتراض Xray، حتى يبقى وصولك للراوتر والأجهزة المحلية مباشراً.</div><div class="switchrow"><div><strong>مرور TCP عبر VLESS</strong><p class="hint">تشغيل أو إيقاف التوجيه الشفاف</p></div><input type="checkbox" class="switch" id="isoSwitch"></div><div class="buttons"><button class="btn secondary" data-tab="servers">تعديل إعداد VLESS</button></div></article></section>
<section id="devices" class="tab"><h1>الأجهزة ◫</h1><p class="hint">الأجهزة المعروفة من حجوزات DHCP الحقيقية؛ الاستهلاك لكل جهاز يحتاج حزمة إحصائيات إضافية ولن نخترع أرقاماً.</p><article class="panel"><div class="section-head"><h2>الأجهزة</h2><button class="btn secondary" id="devicesRefresh">تحديث</button></div><div id="devicesList"><p class="hint">جارِ القراءة</p></div></article></section>
<section id="settings" class="tab"><h1>الإعدادات ⚙</h1><p class="hint">خيارات على طريقة XLite بالفيديو. المؤشرات الفعلية تُقرأ من الراوتر، والخيارات غير المنفّذة موضحة بوضوح.</p>
<article class="panel tint"><h2>الإعدادات السريعة</h2><div class="item"><div><strong>الشفافية و Xray</strong><small>تحكم التوجيه من تبويب السيرفرات</small></div><button class="btn secondary" data-tab="servers">السيرفرات</button></div><div class="item"><div><strong>دمج الخطوط</strong><small>mwan3: متوازن، احتياطي، أقل تأخير</small></div><button class="btn secondary" data-tab="merge">الدمج</button></div><div class="item"><div><strong>وضع الإنترنت</strong><small>VLESS أو الاتصال المباشر</small></div><span class="pill" id="modeState">يُقرأ...</span></div></article>
<article class="panel"><h2>v2rayA / إعدادات البروكسي</h2><div class="item"><div><strong>خدمة v2rayA الموجودة على الراوتر</strong><small>لا نغيّر إعدادات تطبيقك الحالي تلقائياً</small></div><span id="v2rayaState" class="pill">فحص</span></div><div class="buttons"><a class="btn secondary" href="http://192.168.1.1:2017/" target="_blank" rel="noopener">فتح لوحة v2rayA</a></div><p class="hint">وضع التوجيه (redirect/tproxy)، RoutingA وGFWList تُدار داخل v2rayA إذا كانت متوفرة فيه.</p></article>
<article class="panel"><h2>🌐 DNS والخصوصية</h2><div class="item"><div><strong>خوادم DNS الحالية</strong><small>قراءة فقط، بدون تغيير مسارات الإنترنت</small></div><span class="pill" id="dnsState">—</span></div><div class="item"><div><strong>DoH / DNS غير محلي</strong><small>يتطلب ضبط خدمة DNS مناسبة وليس مجرد زر شكلي</small></div><span class="pill">يُضبط من OpenWrt</span></div></article>
<article class="panel"><h2>⚡ الأداء والتوجيه</h2><div class="item"><div><strong>TCP Fast Open</strong><small>حالة النظام إن توفرت</small></div><span class="pill" id="tfoState">—</span></div><div class="item"><div><strong>Smart Mux / Sniffing</strong><small>إعدادات Xray المتقدمة تحتاج توافق السيرفر؛ لا تُشغّل تلقائياً</small></div><span class="pill">متقدم</span></div><div class="item"><div><strong>WireGuard</strong><small>يحتاج إعداد نفق مستقـل، VLESS مو بديل عنه</small></div><span class="pill" id="wgState">—</span></div></article>
<article class="panel"><h2>تحديث Zabour أونلاين</h2><div class="item"><div><strong>الإصدار المثبت</strong><small>v5.0.0 · تحديثات من مستودعك</small></div><span class="pill" id="updateVersion">5.0.0</span></div><div class="buttons"><button class="btn secondary" id="checkUpdate">التحقق من تحديث</button><button class="btn" id="applyUpdate">تثبيت التحديث</button></div><div class="note" id="updateStatus">لا تغيّر الأداة إعداد WAN أو Wi-Fi أثناء تحديث واجهتها.</div></article><article class="panel"><h2>فحص الخدمات</h2><div class="item"><div><strong>OpenWrt mwan3</strong><small>حالة سياسة توجيه الشبكات</small></div><span id="mwanIndicator" class="pill">–</span></div><div class="item"><div><strong>Xray</strong><small>خدمة نفق VLESS الاختيارية</small></div><span id="xrayIndicator" class="pill">–</span></div><div class="buttons"><button class="btn secondary" id="diagRefresh">إعادة الفحص</button></div><details><summary class="small" style="cursor:pointer;margin:12px 0">عرض تفاصيل mwan3</summary><pre class="code" id="mwanRaw"></pre></details></article><article class="panel"><h2>الوصول المحلي المؤقت</h2><p class="hint">الدخول بدون رمز مفعّل مؤقتاً لأجهزة شبكة LAN فقط. رجّع الحماية بعد إنهاء الفحص.</p><button class="btn danger" id="logout">إزالة المفتاح من المتصفح</button><p class="hint" style="margin-top:10px">يمكن استرجاع المفتاح من SSH بالأمر: <span class="kbd">cat /etc/zabour/token</span></p></article></section>
</main>
<nav id="tabs"><button data-tab="home" class="active"><span>⌂</span>الرئيسية</button><button data-tab="servers"><span>▤</span>السيرفرات</button><button data-tab="routes"><span>↳</span>التوزيع</button><button data-tab="isolation"><span>⬡</span>العزل</button><button data-tab="devices"><span>▣</span>الأجهزة</button><button data-tab="merge"><span>⤨</span>الدمج</button><button data-tab="settings"><span>☷</span>الإعدادات</button></nav>
<div class="login" id="login"><article class="panel"><div class="logo">ZABOUR <b>⟠</b></div><h1>مرحبا بيك</h1><p class="hint">دخل مفتاح الأمان الظاهر من تثبيت الأداة بالراوتر. ما نطلب حساب خارجي ولا VPS.</p><label class="f">مفتاح الوصول</label><input id="token" type="password" autocomplete="off" placeholder="ACCESS KEY"><button id="enter" class="btn" style="width:100%;margin-top:12px">الدخول</button><p class="hint" style="margin-top:15px">أو استخرجه بأمر: <span class="kbd">cat /etc/zabour/token</span></p></article></div><div class="toast hidden" id="toast"></div>
<script>
'use strict';const $=id=>document.getElementById(id);let token='LAN-GUEST', current=null, last=null, mode='balanced';
function notify(msg,bad=false){const t=$('toast');t.textContent=msg;t.classList.toggle('error',bad);t.classList.remove('hidden');clearTimeout(notify.timer);notify.timer=setTimeout(()=>t.classList.add('hidden'),5000)}
async function api(payload){const post=!!payload;const r=await fetch(post?'../cgi-bin/zabour-api':'../cgi-bin/zabour-api?status',{method:post?'POST':'GET',headers:{'X-Zabour-Token':token,...(post?{'Content-Type':'application/json'}:{})},body:post?JSON.stringify(payload):undefined,cache:'no-store'});const response=await r.text();let j;try{j=JSON.parse(response)}catch(e){throw Error('API invalid JSON (HTTP '+r.status+'): '+response.slice(0,140))}if(!j.ok)throw Error(j.error||'فشل الطلب');return j}
function toTab(t){document.querySelectorAll('.tab').forEach(el=>el.classList.toggle('active',el.id===t));document.querySelectorAll('[data-tab]').forEach(el=>el.classList.toggle('active',el.dataset.tab===t));window.scrollTo({top:0,behavior:'smooth'});if(t==='devices')loadDevices();if(t==='merge')discover();if(t==='servers'){loadProfile();loadServerList()}if(t==='settings')refreshFeatures()}
document.addEventListener('click',e=>{const b=e.target.closest('[data-tab]');if(b)toTab(b.dataset.tab)});
function fmt(v){return Number(v||0).toFixed(1)}
function loadSelect(id,options,selected){const s=$(id);if(!s)return;s.replaceChildren();(options.length?options:['']).forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v||'ماكو واجهات مكتشفة';s.append(o)});if(selected&&options.includes(selected))s.value=selected}
function lineCard(line,i,mbps){const el=document.createElement('div');el.className='linecard';const name=document.createElement('div');const title=document.createElement('strong');title.textContent=(i===0?'الخط الأول':'الخط الثاني')+' · '+line.name;const extra=document.createElement('small');extra.textContent=(line.ip||'لا يوجد IP')+' · '+(line.device||'لا يوجد جهاز');name.append(title,extra);const v=document.createElement('div');v.style.textAlign='left';const label=document.createElement('div');label.className=line.up?'on':'off';label.textContent=line.up?'● متصل':'● غير متصل';const sp=document.createElement('div');sp.className='speed';sp.textContent=fmt(mbps)+' Mbps';v.append(label,sp);el.append(name,v);return el}
function updateStatus(j){current=j;let rates=[0,0];const now=performance.now();if(last&&now>last.at+350){rates=j.lines.map((v,i)=>Math.max(0,(v.rx-(last.lines[i]?.rx||0))*8/(now-last.at)/1000))}last={at:now,lines:j.lines};const sum=rates.reduce((a,b)=>a+b,0);$('totalSpeed').textContent=fmt(sum);$('upCount').textContent=j.lines.filter(x=>x.up).length+'/2';$('sumRx').textContent=(j.lines.reduce((a,b)=>a+(b.rx||0),0)/1e9).toFixed(2)+' GB';$('rStatus').textContent=$('upCount').textContent;const list=$('homeLines');list.replaceChildren(...j.lines.map((x,i)=>lineCard(x,i,rates[i])));$('modeState').textContent=j.xray_active?'Xray متصل':'مباشر';$('routerDot').classList.toggle('up',j.lines.some(x=>x.up));$('routerTxt').textContent=j.lines.some(x=>x.up)?'الراوتر متصل':'لا يوجد خط متصل';const c=j.settings;mode=c.mode||'balanced';$('activeMode').textContent={balanced:'توزيع متوازن',failover:'احتياطي',latency:'الأقل تأخير'}[mode]||mode;$('mergeOn').checked=!!c.merge_enabled;$('trackMode').value=c.track_mode||'gateway';$('wan1').dataset.saved=c.wan1;$('wan2').dataset.saved=c.wan2;$('weight1').value=c.weight1;$('weight2').value=c.weight2;$('r1Weight').textContent=c.weight1;$('r2Weight').textContent=c.weight2;$('vpnSwitch').checked=c.vless_enabled;$('transparentSwitch').checked=c.transparent;$('isoSwitch').checked=c.transparent;$('xrayStatus').textContent=j.xray_active?'متصل':'متوقف';$('xrayIndicator').textContent=j.xray_active?'يعمل':'متوقف';$('mwanRaw').textContent=j.mwan_status||'mwan3 لا يعرض حالة';$('mwanIndicator').textContent=j.mwan_status?'مثبت':'غير متاح';$('routeDetail').textContent='الوضع: '+$('activeMode').textContent+' · الخط الأول '+c.wan1+' (وزن '+c.weight1+') · الخط الثاني '+c.wan2+' (وزن '+c.weight2+'). توزيع على مستوى الاتصال وليس دمج اتصال TCP منفرد.';document.querySelectorAll('.mode').forEach(b=>b.classList.toggle('chosen',b.dataset.mode===mode))}
async function refresh(){if(!token)return;try{const j=await api();$('login').classList.add('hidden');updateStatus(j)}catch(e){if(e.message.includes('Unauthorized')){$('login').classList.remove('hidden');token='';localStorage.removeItem('zabour_token')}else notify(e.message,true)}}
async function discover(){try{const j=await api({action:'discover'});loadSelect('wan1',j.interfaces,current?.settings?.wan1||'wan');loadSelect('wan2',[...new Set(['zbwan2',...j.interfaces])],current?.settings?.wan2||'zbwan2');loadSelect('lanPort',j.devices.filter(d=>/^lan\d+$/.test(d)),'');loadSelect('usbDevice',j.devices.filter(d=>/^(usb\d+|rndis\d+|eth\d+|wwan\d+)$/.test(d)),'');loadSelect('wifiRadio',j.radios,j.radios[0])}catch(e){notify(e.message,true)}}
async function loadDevices(){try{const r=await api({action:'devices'}),root=$('devicesList');root.replaceChildren();$('homeDeviceSummary').textContent=r.devices.length+' أجهزة معروفة من DHCP';if(!r.devices.length){root.textContent='ماكو أجهزة ظاهرة بحجوزات DHCP';return}for(const x of r.devices){const el=document.createElement('div');el.className='item';const p=document.createElement('div');const n=document.createElement('strong');n.textContent=x.hostname||'جهاز';const m=document.createElement('small');m.textContent=x.mac;p.append(n,m);const ip=document.createElement('span');ip.className='pill';ip.textContent=x.ip;el.append(p,ip);root.append(el)}}catch(e){notify(e.message,true)}}
async function loadProfile(){try{const r=await api({action:'profile'});$('serverLabel').textContent=r.profile?(r.profile.name||r.profile.address):'لا يوجد سيرفر';$('homeServer').textContent=r.profile?(r.profile.name+' · '+r.profile.address+':'+r.profile.port):'لا يوجد سيرفر';$('serverDetails').textContent=r.profile?`${r.profile.address}:${r.profile.port} · ${r.profile.network} · ${r.profile.security}`:'أضف رابط VLESS لتشغيله.'}catch(e){notify(e.message,true)}}
function parseVless(str){
  const original=String(str||'').trim();
  if(!original.toLowerCase().startsWith('vless://'))throw Error('الرابط لازم يبدأ vless://');
  const u=new URL(original);const p=u.searchParams;
  const id=decodeURIComponent(u.username).toLowerCase();
  if(!/^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/.test(id))throw Error('UUID غير صالح (لازم 36 حرف)');
  const port=Number(u.port);if(!Number.isInteger(port)||port<1||port>65535)throw Error('منفذ Port غير صالح');
  const address=u.hostname.replace(/^\[/,'').replace(/\]$/,'');if(!address||address.length>253)throw Error('عنوان السيرفر غير صالح');
  const network=(p.get('type')||'tcp').toLowerCase(), security=(p.get('security')||'none').toLowerCase();
  if(!['tcp','ws','grpc'].includes(network))throw Error('نوع الاتصال مو مدعوم: '+network);
  if(!['none','tls','reality'].includes(security))throw Error('نوع الحماية مو مدعوم: '+security);
  const rawName=(u.hash||'').slice(1);let name='VLESS';try{name=decodeURIComponent(rawName)||'VLESS'}catch(e){name=rawName||'VLESS'}
  return {proto:'vless',id,address,port,network,security,host:p.get('host')||'',path:p.get('path')||'/',sni:p.get('sni')||p.get('serverName')||'',headerType:p.get('headerType')||'',flow:p.get('flow')||'',fingerprint:p.get('fp')||'',publicKey:p.get('pbk')||'',shortId:p.get('sid')||'',spiderX:p.get('spx')||'',serviceName:p.get('serviceName')||'',name:name.slice(0,100)};
}
async function loadServerList(){const r=await api({action:'servers_list'}),root=$('savedServers');root.replaceChildren();if(!r.servers?.length){root.textContent='ماكو سيرفرات محفوظة، أضف رابط VLESS أولاً';return}r.servers.forEach((x,i)=>{const row=document.createElement('div');row.className='server-entry';const meta=document.createElement('div'),n=document.createElement('strong'),sub=document.createElement('small');n.textContent=x.name||'VLESS';sub.textContent=x.address+':'+x.port+' · '+x.network+' · '+x.security;meta.append(n,sub);const select=document.createElement('button');select.className='btn secondary';select.textContent='اختيار';select.onclick=async()=>{try{await api({action:'server_select',index:i});await loadProfile();notify('تم اختيار السيرفر')}catch(e){notify(e.message,true)}};const del=document.createElement('button');del.className='btn danger';del.textContent='حذف';del.onclick=async()=>{if(!confirm('حذف السيرفر من القائمة؟'))return;try{await api({action:'server_delete',index:i});await loadServerList();notify('تم الحذف')}catch(e){notify(e.message,true)}};row.append(meta,select,del);root.append(row)})}
async function refreshFeatures(){try{const j=await api({action:'features'});$('v2rayaState').textContent=j.v2raya?'يعمل':'غير شغّال';$('wgState').textContent=j.wireguard?'موجود':'غير مثبت';$('dnsState').textContent=j.dns||'تلقائي';$('tfoState').textContent=j.tcp_fastopen||'غير معروف'}catch(e){notify(e.message,true)}}

function task(btn,handler){$(btn).addEventListener('click',async()=>{const b=$(btn);b.disabled=true;try{const done=await handler();if(done!==false){notify('تم التنفيذ بنجاح');await refresh()}}catch(e){notify(e.message,true)}finally{b.disabled=false}})}
task('enter',async()=>{token=$('token').value.trim();const j=await api();localStorage.setItem('zabour_token',token);updateStatus(j);$('login').classList.add('hidden');await discover()});
task('saveApply',async()=>{const a={action:'save',wan1:$('wan1').value,wan2:$('wan2').value,mode,weight1:Number($('weight1').value),weight2:Number($('weight2').value),track_mode:$('trackMode').value};if(!$('mergeOn').checked){await api({action:'stop_merge'});return}await api(a);await api({action:'apply'})});
document.querySelectorAll('.mode').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('.mode').forEach(x=>x.classList.toggle('chosen',x===b))}));
task('lanBtn',async()=>{const dev=$('lanPort').value;if(!dev)throw Error('اختار منفذ LAN');if(!confirm('راح يتحول '+dev+' إلى مدخل إنترنت، وقد تفقد اتصالك إذا كنت تستخدمه للإدارة. متأكد؟'))return false;await api({action:'lan',device:dev});await discover()});
task('usbBtn',async()=>{const dev=$('usbDevice').value;if(!dev)throw Error('شبّك الهاتف USB وفعّل المشاركة أولاً');await api({action:'usb',device:dev});await discover()});
task('scanWifi',async()=>{const j=await api({action:'wifi_scan',radio:$('wifiRadio').value});$('wifiScanResult').textContent=j.scan||'ماكو شبكات مكتشفة';return false});
task('wifiBtn',async()=>{const radio=$('wifiRadio').value,ssid=$('hotspotSSID').value,password=$('hotspotPass').value;if(!ssid||password.length<8)throw Error('اسم ورمز Wi‑Fi غير صالح');if(!confirm('الاتصال ببث الهاتف قد يعيد تشغيل الواي فاي مؤقتاً. نكمل؟'))return false;await api({action:'wifi',radio,ssid,password});$('hotspotPass').value='';await discover()});
task('previewVless',async()=>{const p=parseVless($('vlessLink').value);$('vlessPreview').textContent='الاسم: '+p.name+' | '+p.address+':'+p.port+' | '+p.network+'/'+p.security+' | Host: '+(p.host||'—')+' | Path: '+p.path;return false});
task('saveVless',async()=>{const profile=parseVless($('vlessLink').value);await api({action:'vless',profile});$('vlessLink').value='';await loadProfile();await loadServerList()});
task('startProxy',async()=>{if($('transparentSwitch').checked&&!$('vpnSwitch').checked)throw Error('فعّل VLESS قبل التوجيه الشفاف');if($('transparentSwitch').checked&&!confirm('سيجري تحويل TCP من أجهزة LAN إلى VLESS. إذا السيرفر ما يشتغل، ممكن تتعطل اتصالات TCP. تفعيل؟'))return false;await api({action:'proxy',enabled:$('vpnSwitch').checked,transparent:$('transparentSwitch').checked})});
task('stopProxy',async()=>{await api({action:'stop_proxy'})});
task('serversRefresh',loadServerList);task('checkUpdate',async()=>{const j=await api({action:'update_check'});$('updateStatus').textContent='المثبت '+j.current+' · المتوفر '+j.latest+(j.available?' · تحديث متاح':' · أحدث إصدار');return false});task('applyUpdate',async()=>{if(!confirm('تحديث جميع ملفات Zabour الآن؟ يتم حفظ نسخة احتياطية بدون تغيير إعدادات WAN أو Wi-Fi.'))return false;const j=await api({action:'update_apply'});$('updateStatus').textContent=j.updated?'تم تحديث كل ملفات Zabour إلى '+j.latest+'؛ جارِ فتح الواجهة الجديدة.':'الإصدار مثبت بالفعل';if(j.updated)setTimeout(()=>location.replace('/zabour/open.html?v='+encodeURIComponent(j.latest)),1200);return false});['refreshBtn','diagRefresh'].forEach(id=>task(id,refresh));task('devicesRefresh',loadDevices);$('logout').addEventListener('click',()=>{localStorage.removeItem('zabour_token');token='';$('token').value='';$('login').classList.remove('hidden')});$('isoSwitch').addEventListener('change',e=>{$('transparentSwitch').checked=e.target.checked;toTab('servers')});
if(token){$('token').value=token;refresh().then(discover)}else $('login').classList.remove('hidden');setInterval(()=>{if(token&&document.visibilityState==='visible')refresh()},2500);
</script></body></html>